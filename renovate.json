{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended"
  ],

  "ignorePaths": [
    "**/node_modules/**"
  ],

  "helm-values": {
    "managerFilePatterns": ["/(^|/).*\\.ya?ml$/"]
  },

  "kubernetes": {
    "managerFilePatterns": ["/(^|/).*\\.ya?ml$/"]
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "CloudNativePG PostgreSQL images in the ImageCatalog (e.g. 18.7-standard-trixie)",
      "managerFilePatterns": [
        "/cnpg-cluster/templates/imagecatalog.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "TimescaleDB HA images in the ImageCatalog (e.g. pg18.7-ts2.32.1-r606.1)",
      "managerFilePatterns": [
        "/cnpg-cluster/templates/imagecatalog.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>timescale/timescaledb-ha):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^pg(?<major>\\d+)\\.(?<minor>\\d+)-ts(?<compatibility>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-r(?<revision>\\d+)\\.\\d+$"
    },
    {
      "customType": "regex",
      "description": "appVersion of the vexr chart follows the vexr image tag in values.yaml (the chart version is bumped by hand)",
      "managerFilePatterns": ["/^vexr/Chart\\.yaml$/"],
      "matchStrings": [
        "appVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "depNameTemplate": "ghcr.io/sfotiadis/vexr",
      "datasourceTemplate": "docker"
    }
  ],

  "packageRules": [
    {
      "description": "No major updates for images in the Helm charts (e.g. PostgreSQL 16 -> 18). Major upgrades are done by hand.",
      "matchManagers": ["custom.regex", "kubernetes", "helm-values"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Update the vexr image tag and the appVersion of the chart in one pull request",
      "matchPackageNames": ["ghcr.io/sfotiadis/vexr"],
      "groupName": "vexr"
    }
  ]
}
